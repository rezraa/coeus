{
  "spec_id": "coeus-Gmetric-v1",
  "story": "story-19e9ceb1",
  "title": "Frozen G-metric scorecard for the Coeus retrieval refactor",
  "authored_by": "Themis",
  "status": "FROZEN",
  "one_line": "Concept-level recall@10 over a method-independent reachable set of 130 golds; Shape C must beat the rule-routed baseline on the same set.",
  "problem_statement": {
    "disagreement_resolved": "Two tome measurements disagreed ~3-4x on 'how much is reachable': m-10b5c0a0 said 108/209 (concept judge, but denominator = A-union-B-union-C retrieval UNION -> CIRCULAR, method-dependent), m-01392e91 said ~28-43/209 (HONEST full denominator but EXACT-STRING grader that under-credits, e.g. time_series_db != 'Time-Series Database' per m-879a7403).",
    "fix": "Take the good half of each: concept-level GRADER (from Shape C) applied to a METHOD-INDEPENDENT denominator (fix the circularity) computed by checking each gold directly against the corpus."
  },
  "1_grader": {
    "type": "curated_concept_map",
    "decision": "Curated concept/alias map, NOT a live LLM judge.",
    "why": "The map is a frozen deterministic lookup table -> 'compute twice, same score' holds exactly. An LLM concept-judge (even temp 0) drifts across model versions and is not replayable; it was fine as a one-off measurement but cannot be the LOCKED grader. The map already encodes the concept-level judgment (naming variants + mechanism-equivalence) that fixed the exact-string under-crediting.",
    "rule": "A gold is CONCEPT-COVERED by a method iff the method's ranked output (top-k corpus pattern IDs for that problem) contains ANY of the acceptable_corpus_ids the frozen map assigns to that gold. Naming variants and mechanism-equivalents are pre-encoded (e.g. Time-Series Database -> time_series_db; Saga -> saga_orchestration|saga_choreography; Immutable Audit Log -> event_log; Geo-Sharding -> data_partitioning|multi_region).",
    "novel_pattern_fallback": "If a future method surfaces a corpus pattern for a gold that the map did not anticipate, an LLM concept-judge with the rubric below adjudicates ONLY that new (gold, pattern) pair; the verdict is then written back into the map (map grows monotonically, never silently re-decides existing rows).",
    "rubric_for_map_and_fallback": {
      "E_exists": "Corpus has a standalone pattern whose primary subject IS the gold's architectural concept, counting naming variants and a pattern that IS that mechanism under a different label.",
      "B_borderline": "Concept present ONLY as an embedded key_concept/signal of a pattern about something else (e.g. anti_corruption_layer inside monolith_to_microservices; consistent_hashing inside cache/kv patterns; optimistic_concurrency inside rest_partial_updates; correlation_id inside event_driven), OR a composite/specialization of generic patterns where reasonable judges differ. NOT a first-class retrievable pattern.",
      "A_absent": "Concept appears nowhere in the corpus (verified by direct grep of all three pattern files)."
    }
  },
  "2_denominator": {
    "definition": "METHOD-INDEPENDENT reachable set = the golds whose architectural concept actually EXISTS in Coeus's corpus, determined by checking each gold DIRECTLY against the 174 patterns at concept level. Does NOT depend on what any retrieval method returned (this removes the circularity flaw in m-10b5c0a0's 108).",
    "FROZEN_reachable_set_size": 130,
    "breakdown": {
      "E_exists_reachable": 130,
      "B_borderline_embedded_excluded": 30,
      "A_absent_content_floor": 49,
      "total_golds": 209
    },
    "borderline_policy": "The 30 borderline (embedded-only / composite) golds are EXCLUDED from BOTH numerator and denominator (scored neutral). A method surfacing them earns no credit and no penalty. This keeps the metric crisp and reproducible and refuses to grade on concepts that are not first-class retrievable patterns.",
    "denominator_is_stable": "Because baseline and after are scored over the SAME 130-set, the denominator CANCELS in the pass/fail comparison. Its exact value (130 strict vs 160 lenient) changes only the reported percentage, never the C-vs-baseline verdict.",
    "lenient_denominator_if_borderline_credited": 160
  },
  "3_score": {
    "metric": "concept_recall_at_k",
    "formula": "recall@k = (# of the 130 E-golds whose acceptable_corpus_ids intersect the method's top-k pattern IDs for that problem, summed over all 25 problems) / 130",
    "primary_cutoff_k": 10,
    "secondary_cutoff_k": 5,
    "cutoff_rationale": "k=10 is the primary pass/fail operating point (a reasoning Titan reads a ~10-pattern bundle; both prior tome measurements report @10; less rank-noise than @5). k=5 is a secondary ranking-quality diagnostic (the capstone's decisive claim was a RANKING win: C@5 > B@10).",
    "method_output_contract": "Each method emits, per problem, a rank-ordered list of DISTINCT corpus pattern IDs. Baseline = current rule-routed retrieval (problem/signals -> decision_rules -> recommended_patterns traversal). After = Shape C (LLM working-memory signal match -> pattern-direct hydrate). Same benchmark inputs, same corpus snapshot, same k."
  },
  "4_baseline_vs_after": {
    "baseline": "rule_routed_retrieval (signal/problem -> rule -> recommended_patterns; the current production path, = Shape A in the tome)",
    "after": "shape_C (deterministic signal index in working memory -> Titan concept match -> pattern-direct hydrate)",
    "PASS_condition_FROZEN": {
      "primary": "recall@10(shape_C) - recall@10(baseline) >= 0.10 of the reachable set (i.e. shape_C covers at least 13 more of the 130 golds than baseline). A strict > with an anti-noise margin.",
      "robustness_1_design_works_floor": "recall@10(shape_C) >= 0.50 (>= 65 of 130). Establishes the new path actually surfaces a majority of what is reachable, not merely that it beats a broken baseline.",
      "robustness_2_distribution": "shape_C recall@10 >= baseline recall@10 on >= 22 of 25 problems (guards against a win concentrated in a few problems; the capstone observed 24/25).",
      "verdict_rule": "G-metric PASS = primary AND robustness_1 AND robustness_2. Any one failing = NOT a pass; return to council, do not close the story on it."
    },
    "notes": "Thresholds are set for the measured effect size (capstone: C@10=98 vs A@10=23 on the old 108-set, >4x) so a real win clears them trivially and a marginal/noise result correctly fails. Prometheus/council may ratify or adjust the margins BEFORE any code is written; once code starts, the bar is locked."
  },
